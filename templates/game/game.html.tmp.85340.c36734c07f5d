{% extends 'base.html' %}
{% load static %}

{% block title %}Play — ARIA: The Lost Code{% endblock %}
{% block meta_description %}ARIA: The Lost Code — the game is running.{% endblock %}

{# ── Suppress the site nav and footer during gameplay ── #}
{% block footer %}{% endblock %}

{% block extra_css %}
<style>
    /* Lock the viewport — no scroll bars during play */
    html, body {
        overflow: hidden;
        background: #0d0d1a;
        height: 100%;
        margin: 0;
        padding: 0;
    }

    /* Hide the site header during gameplay */
    body > header { display: none; }

    /* main padding comes from base.html; override it here */
    body > main {
        padding: 0;
        margin: 0;
        height: 100%;
    }

    /* ── Game wrapper: canvas area + ARIA bar stacked vertically ── */
    #game-wrapper {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        background: #0d0d1a;
    }

    /* Canvas area fills all space above the ARIA bar */
    #game-canvas-area {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    /* Phaser mounts its <canvas> inside this div */
    #game-container {
        /* Phaser Scale.FIT will handle actual sizing */
        line-height: 0;
    }

    /* ── ARIA dialogue bar (bottom strip) ── */
    #aria-bar {
        flex-shrink: 0;
        height: 72px;
        background: #0a0a16;
        border-top: 1px solid #1e1e3e;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0 1rem;
        z-index: 10;
    }

    /* ARIA avatar circle */
    #aria-avatar {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #111130;
        border: 2px solid #00ff88;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        box-shadow: 0 0 8px rgba(0, 255, 136, 0.3);
    }

    /* ARIA dialogue text */
    #aria-text {
        flex: 1;
        color: #00ff88;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        line-height: 1.3;
        opacity: 1;
        transition: opacity 0.4s ease;
        /* Truncate long lines gracefully */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Chances HUD ── */
    #hud-chances {
        flex-shrink: 0;
        display: flex;
        gap: 5px;
        align-items: center;
    }

    .chance-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #00ff88;
        box-shadow: 0 0 6px rgba(0, 255, 136, 0.6);
        transition: background 0.3s, box-shadow 0.3s;
    }

    .chance-dot.lost {
        background: #1e1e3e;
        box-shadow: none;
    }

    /* ── Tablet button ── */
    #tablet-btn {
        flex-shrink: 0;
        background: #12122a;
        border: 1px solid #3a3a7a;
        color: #8888cc;
        padding: 0.35rem 0.85rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Courier New', Courier, monospace;
        letter-spacing: 0.03em;
        transition: border-color 0.2s, color 0.2s;
    }

    #tablet-btn:hover {
        border-color: #00ff88;
        color: #00ff88;
    }

    /* ── Region label (top-left corner overlay) ── */
    #region-label {
        position: fixed;
        top: 0.6rem;
        left: 0.75rem;
        color: #3a3a6a;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        pointer-events: none;
        z-index: 5;
    }
</style>
{% endblock %}


{% block content %}
<div id="game-wrapper">

    {# Canvas area — Phaser mounts here #}
    <div id="game-canvas-area">
        <div id="game-container"></div>
    </div>

    {# ARIA dialogue bar #}
    <div id="aria-bar">
        <div id="aria-avatar" title="ARIA">⚡</div>

        <span id="aria-text">
            ARIA: "Initializing connection&hellip;"
        </span>

        <div id="hud-chances" title="Chances remaining">
            <div class="chance-dot" data-chance="1"></div>
            <div class="chance-dot" data-chance="2"></div>
            <div class="chance-dot" data-chance="3"></div>
        </div>

        <button id="tablet-btn" type="button">📟 Tablet</button>
    </div>

</div>

{# Region label overlay #}
<div id="region-label">Region 1 &mdash; The Origin Node</div>
{% endblock %}


{% block extra_js %}
{# Phaser 3 via CDN — must load before our game scripts #}
<script src="https://cdn.jsdelivr.net/npm/phaser@3.70.0/dist/phaser.min.js"></script>

{# Game scripts — order matters; config first, map second, scene third, main last #}
<script src="{% static 'js/game/config.js' %}"></script>
<script src="{% static 'js/game/maps/origin_node.js' %}"></script>
<script src="{% static 'js/game/scenes/OriginNodeScene.js' %}"></script>
<script src="{% static 'js/game/main.js' %}"></script>
{% endblock %}

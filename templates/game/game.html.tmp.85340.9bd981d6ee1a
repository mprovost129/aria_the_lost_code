{% extends 'base.html' %}
{% load static %}

{% block title %}Play — ARIA: The Lost Code{% endblock %}
{% block meta_description %}ARIA: The Lost Code — the game is running.{% endblock %}

{# ── Suppress the site nav and footer during gameplay ── #}
{% block footer %}{% endblock %}

{% block extra_css %}
<style>
    /* Lock the viewport — no scroll bars during play */
    html, body {
        overflow: hidden;
        background: #0d0d1a;
        height: 100%;
        margin: 0;
        padding: 0;
    }

    /* Hide the site header during gameplay */
    body > header { display: none; }

    /* main padding comes from base.html; override it here */
    body > main {
        padding: 0;
        margin: 0;
        height: 100%;
    }

    /* ── Game wrapper: canvas area + ARIA bar stacked vertically ── */
    #game-wrapper {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        background: #0d0d1a;
    }

    /* Canvas area fills all space above the ARIA bar */
    #game-canvas-area {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    /* Phaser mounts its <canvas> inside this div */
    #game-container {
        /* Phaser Scale.FIT will handle actual sizing */
        line-height: 0;
    }

    /* ── ARIA dialogue bar (bottom strip) ── */
    #aria-bar {
        flex-shrink: 0;
        height: 72px;
        background: #0a0a16;
        border-top: 1px solid #1e1e3e;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0 1rem;
        z-index: 10;
    }

    /* ARIA avatar circle */
    #aria-avatar {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #111130;
        border: 2px solid #00ff88;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        box-shadow: 0 0 8px rgba(0, 255, 136, 0.3);
    }

    /* ARIA dialogue text */
    #aria-text {
        flex: 1;
        color: #00ff88;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        line-height: 1.3;
        opacity: 1;
        transition: opacity 0.4s ease;
        /* Truncate long lines gracefully */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Chances HUD ── */
    #hud-chances {
        flex-shrink: 0;
        display: flex;
        gap: 5px;
        align-items: center;
    }

    .chance-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #00ff88;
        box-shadow: 0 0 6px rgba(0, 255, 136, 0.6);
        transition: background 0.3s, box-shadow 0.3s;
    }

    .chance-dot.lost {
        background: #1e1e3e;
        box-shadow: none;
    }

    /* ── Tablet button ── */
    #tablet-btn {
        flex-shrink: 0;
        background: #12122a;
        border: 1px solid #3a3a7a;
        color: #8888cc;
        padding: 0.35rem 0.85rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Courier New', Courier, monospace;
        letter-spacing: 0.03em;
        transition: border-color 0.2s, color 0.2s;
    }

    #tablet-btn:hover {
        border-color: #00ff88;
        color: #00ff88;
    }

    /* ── Region label (top-left corner overlay) ── */
    #region-label {
        position: fixed;
        top: 0.6rem;
        left: 0.75rem;
        color: #3a3a6a;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        pointer-events: none;
        z-index: 5;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       CHALLENGE PANEL OVERLAY
       Layer 4: slides up from below when the player bumps a gate.
    ═══════════════════════════════════════════════════════════════════════ */

    /* Dark backdrop */
    #challenge-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0);
        z-index: 100;
        pointer-events: none;
        transition: background 0.25s ease;
    }
    #challenge-overlay.open {
        background: rgba(0, 0, 0, 0.82);
        pointer-events: all;
    }

    /* The panel itself */
    #challenge-panel {
        position: absolute;
        bottom: 72px;   /* sits above the ARIA bar */
        left: 50%;
        transform: translateX(-50%) translateY(110%);
        width: min(780px, 96vw);
        max-height: 74vh;
        background: #0a0a18;
        border: 1px solid #ff3333;
        border-radius: 8px 8px 0 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 -4px 32px rgba(255, 50, 50, 0.2);
    }
    #challenge-overlay.open #challenge-panel {
        transform: translateX(-50%) translateY(0);
    }

    /* Header row */
    #cp-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #1e1e3e;
        background: #0d0d20;
        flex-shrink: 0;
    }
    #cp-title {
        flex: 1;
        color: #e0e0ff;
        font-family: 'Courier New', Courier, monospace;
        font-size: 1rem;
        font-weight: bold;
    }
    .cp-badge {
        font-size: 0.7rem;
        font-family: 'Courier New', Courier, monospace;
        padding: 0.2rem 0.55rem;
        border-radius: 20px;
        border: 1px solid currentColor;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .cp-badge--fill_blank { color: #00ccff; }
    .cp-badge--bug_fix    { color: #ff8800; }
    .cp-badge--open_code  { color: #aa88ff; }
    .cp-badge--boss       { color: #ff44aa; }

    #cp-close {
        background: none;
        border: none;
        color: #5a5a8a;
        font-size: 1.1rem;
        cursor: pointer;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        line-height: 1;
    }
    #cp-close:hover { color: #ff3333; }

    /* Body (scrollable) */
    #cp-body {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    /* ARIA intro text */
    #cp-aria-text {
        color: #00ff88;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        font-style: italic;
        padding: 0.6rem 0.8rem;
        background: #0d1e14;
        border-left: 3px solid #00ff88;
        border-radius: 0 4px 4px 0;
    }

    /* Code editor */
    #cp-editor-label {
        color: #6a6a9a;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    #cp-editor {
        width: 100%;
        min-height: 130px;
        max-height: 260px;
        background: #060612;
        color: #c8c8ff;
        border: 1px solid #2a2a4a;
        border-radius: 4px;
        padding: 0.75rem;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.9rem;
        line-height: 1.6;
        resize: vertical;
        tab-size: 4;
        outline: none;
        box-sizing: border-box;
    }
    #cp-editor:focus { border-color: #4a4a9a; }

    /* Lesson reference */
    #cp-lesson-ref {
        color: #4a4a7a;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.75rem;
    }
    #cp-lesson-ref::before { content: '📚 '; }

    /* Hint box */
    #cp-hint-box {
        background: #0d1a2e;
        border: 1px solid #2a4a6a;
        border-radius: 4px;
        padding: 0.6rem 0.8rem;
        display: none;
    }
    #cp-hint-box .hint-label {
        color: #4488cc;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 0.25rem;
    }
    #cp-hint-text {
        color: #88bbee;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    /* Code output (Layer 5 — Pyodide stdout display) */
    #cp-output-section {
        display: none;
    }
    .cp-output-label {
        color: #6a6a9a;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.25rem;
    }
    #cp-output {
        background: #060612;
        color: #aaffcc;
        border: 1px solid #1a3a2a;
        border-radius: 4px;
        padding: 0.6rem 0.75rem;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.88rem;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
    }

    /* Pyodide loading indicator (shown in ARIA bar while runtime warms up) */
    #pyodide-status {
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.7rem;
        color: #3a3a6a;
        flex-shrink: 0;
        transition: color 0.4s;
    }
    #pyodide-status.ready { color: #006633; }

    /* Result message */
    #cp-result {
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        padding: 0.5rem 0.75rem;
        border-radius: 4px;
        display: none;
    }
    .cp-result--success { background: #0d2e1a; color: #00ff88; border: 1px solid #00aa44; }
    .cp-result--error   { background: #2e0d0d; color: #ff6666; border: 1px solid #aa2222; }

    /* Footer actions */
    #cp-footer {
        display: flex;
        gap: 0.6rem;
        padding: 0.7rem 1rem;
        border-top: 1px solid #1e1e3e;
        background: #0d0d20;
        flex-shrink: 0;
        align-items: center;
    }
    #cp-shortcut-hint {
        flex: 1;
        color: #2a2a4a;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.7rem;
    }
    .cp-btn {
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        padding: 0.4rem 1rem;
        border-radius: 5px;
        cursor: pointer;
        border: 1px solid transparent;
        transition: background 0.15s, border-color 0.15s;
    }
    #cp-hint-btn {
        background: #0d1a2e;
        color: #4488cc;
        border-color: #2a4a6a;
    }
    #cp-hint-btn:hover   { background: #12253e; }
    #cp-hint-btn:disabled { opacity: 0.4; cursor: default; }
    #cp-submit {
        background: #1a3a1a;
        color: #00ff88;
        border-color: #2a6a2a;
    }
    #cp-submit:hover { background: #224422; border-color: #00aa44; }
</style>
{% endblock %}


{% block content %}
<div id="game-wrapper">

    {# Canvas area — Phaser mounts here #}
    <div id="game-canvas-area">
        <div id="game-container"></div>
    </div>

    {# ARIA dialogue bar #}
    <div id="aria-bar">
        <div id="aria-avatar" title="ARIA">⚡</div>

        <span id="aria-text">
            ARIA: "Initializing connection&hellip;"
        </span>

        <div id="hud-chances" title="Chances remaining">
            <div class="chance-dot" data-chance="1"></div>
            <div class="chance-dot" data-chance="2"></div>
            <div class="chance-dot" data-chance="3"></div>
        </div>

        <button id="tablet-btn" type="button">📟 Tablet</button>
    </div>

</div>

{# Region label overlay #}
<div id="region-label">Region 1 &mdash; The Origin Node</div>

{# ── Challenge Panel Overlay (Layer 4) ── #}
<div id="challenge-overlay">
    <div id="challenge-panel" role="dialog" aria-modal="true" aria-labelledby="cp-title">

        {# Header #}
        <div id="cp-header">
            <span id="cp-title">Challenge</span>
            <span id="cp-type-badge" class="cp-badge cp-badge--fill_blank">Fill in the Blank</span>
            <button id="cp-close" type="button" title="Close (Esc)">✕</button>
        </div>

        {# Scrollable body #}
        <div id="cp-body">

            {# ARIA intro line #}
            <div id="cp-aria-text"></div>

            {# Code editor area #}
            <div id="cp-editor-label">Your Code &mdash; replace every ___ with the correct value:</div>
            <textarea
                id="cp-editor"
                spellcheck="false"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
            ></textarea>

            {# Lesson reference #}
            <div id="cp-lesson-ref" style="display:none;"></div>

            {# Result feedback #}
            <div id="cp-result" class="cp-result"></div>

            {# Hint box (hidden until requested or first wrong answer) #}
            <div id="cp-hint-box">
                <div class="hint-label">💡 Hint</div>
                <div id="cp-hint-text"></div>
            </div>

        </div>{# /cp-body #}

        {# Footer actions #}
        <div id="cp-footer">
            <span id="cp-shortcut-hint">Ctrl+Enter to submit</span>
            <button id="cp-hint-btn"  class="cp-btn" type="button">💡 Hint</button>
            <button id="cp-submit"    class="cp-btn" type="button">▶ Submit</button>
        </div>

    </div>{# /challenge-panel #}
</div>{# /challenge-overlay #}
{% endblock %}


{% block extra_js %}
{# Phaser 3 via CDN — must load before our game scripts #}
<script src="https://cdn.jsdelivr.net/npm/phaser@3.70.0/dist/phaser.min.js"></script>

{# Game scripts — order matters #}
<script src="{% static 'js/game/config.js' %}"></script>
<script src="{% static 'js/game/maps/origin_node.js' %}"></script>
<script src="{% static 'js/game/data/region1_challenges.js' %}"></script>
<script src="{% static 'js/game/scenes/OriginNodeScene.js' %}"></script>
<script src="{% static 'js/game/challenge.js' %}"></script>
<script src="{% static 'js/game/main.js' %}"></script>
{% endblock %}
